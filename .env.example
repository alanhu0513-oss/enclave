# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
JWT_SECRET=enclave_super_secret_jwt_key_for_development_mode_32chars
AUTH_RATE_LIMIT_MAX=100
GLOBAL_RATE_LIMIT_MAX=300
SCAN_RATE_LIMIT_MAX=60

# Database Configuration (Optional PostgreSQL - automatically falls back to JSON file storage)
DATABASE_URL=
POSTGRES_PASSWORD=

# ML Service & Deepfake Detection Engine
ML_SERVICE_URL=http://localhost:8001

# Storage & Uploads
UPLOAD_DIR=./uploads

# Analytics & Monitoring (Optional)
UMAMI_SECRET=
UMAMI_WEBSITE_ID=

# Email Notifications (Optional SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Push Notifications (Optional Firebase Cloud Messaging)
FCM_SERVER_KEY=

# Stripe Billing (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend Configuration
VITE_API_URL=/api
