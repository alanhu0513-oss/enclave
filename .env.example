# ─── Enclave Backend — Environment Variables ───
# Copy to .env and fill in values.

# Server
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://enclave:enclave_pass@localhost:5432/enclave

# Database (JSON fallback — dev only, no DATABASE_URL needed)
# DATABASE_PATH=./data/enclave.json

# Security — REQUIRED in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Uploads
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000

# ML Service (for Docker Compose)
ML_SERVICE_URL=http://ml-service:8001
POSTGRES_PASSWORD=enclave_pass
UMAMI_SECRET=change-me-in-production
