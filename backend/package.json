{
  "name": "enclave-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "test": "DATABASE_PATH=./data/test-enclave.json AUTH_RATE_LIMIT_MAX=1000 GLOBAL_RATE_LIMIT_MAX=100000 jest --forceExit --detectOpenHandles",
    "test:ci": "DATABASE_PATH=./data/test-enclave.json AUTH_RATE_LIMIT_MAX=1000 GLOBAL_RATE_LIMIT_MAX=100000 jest --forceExit --detectOpenHandles --ci",
    "migrate": "node scripts/migrate-json-to-pg.js",
    "migrate:dry": "node scripts/migrate-json-to-pg.js --dry-run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "image-size": "^2.0.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.13.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "optionalDependencies": {
    "pg": "^8.11.3"
  }
}
